# Generate secure values with: bun run secrets
# Copy this file to .env and replace both values before running Docker Compose.
MCP_AUTH_TOKEN=replace-with-a-random-token
WA_AUTH_KEY=replace-with-32-byte-base64-key

# Local Bun uses this directory. Docker Compose mounts the same directory as /data.
DATA_DIR=./data

# Docker maps this port only to localhost by default.
# Host port for Docker Compose. The container itself always listens on 8765.
HOST_PORT=8765
LOG_LEVEL=info

# Optional: only for OpenAI Secure MCP Tunnel. Keep the real runtime key in .env.
OPENAI_TUNNEL_ID=
CONTROL_PLANE_API_KEY=
